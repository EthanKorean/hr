# 비밀이 아닌 설정만 둔다. 비밀번호/시크릿은 이 파일에 쓰지 않는다 -> scripts/init.sh 가 실행 시 입력받아
# 프로세스 환경으로만 사용하며 어디에도 저장하지 않는다. (init.sh 가 이 파일에서 .env 에 없는 키만 보충한다)
COMPOSE_PROJECT_NAME=hr

# 호스트에 노출되는 포트 (8000번대, 충돌 시 변경)
FRONTEND_PORT=8000
GATEWAY_PORT=8001
DB_PORT=8002
REDIS_PORT=8003
MQTT_PORT=8004

# 서비스별 DB 스키마 / DB 계정(<DB_USER>_auth, <DB_USER>_tenant 로 분리 생성됨)
AUTH_DB_NAME=hr_auth
TENANT_DB_NAME=hr_tenant
DB_USER=hr

# 개발 서버 파일 변경 감지 polling. init.sh 가 macOS 에서는 true 로 기록한다
CHOKIDAR_USEPOLLING=__POLLING__

# 최초 기동 시 만들어지는 admin 의 이메일 (비밀번호는 init.sh 가 입력받음. 이후 바꿔도 기존 admin 은 변하지 않는다)
ADMIN_EMAIL=admin@hr.local
